# Copy to .env and fill in real values. Never commit the real .env.

# Anthropic API key, used by services/robez_ocr_vision.py for OCR/vision parsing
ANTHROPIC_API_KEY=

# Optional: model used by the background risk AI worker (services/risk_ai_worker.py).
# Unset = claude-sonnet-4-5, the same model the existing incident pipeline uses.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: language of every text the risk AI worker generates (lv, ru, en).
# Unset = lv (Latvian). The incident pipeline is not affected.
# AI_OUTPUT_LANGUAGE=lv

# Telegram bot token from @BotFather (bot.py refuses to start without this)
TELEGRAM_BOT_TOKEN=

# Copernicus Data Space Ecosystem (Sentinel-2) OAuth client credentials,
# used by api.py's satellite endpoints
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# HTTP Basic Auth credentials required for every api.py route (dashboard + API)
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional: numeric Telegram chat id of the dispatcher who gets alerted when
# a field worker's live location leaves the sector boundary. If unset,
# bot.py just logs "DISPATCHER_CHAT_ID not set" and skips that alert.
DISPATCHER_CHAT_ID=

# Optional overrides — defaults shown
# DB_PATH=data/forest_ai.db
# PHOTOS_DIR=data/work_photos

# ── Integration Layer (services/integrations/) ────────────────────────────

# Required to store/read any integration credential (services/integrations/
# crypto.py, Fernet encryption). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored credentials unrecoverable — back it up
# separately from the database.
INTEGRATION_CREDENTIALS_KEY=

# Optional: per-provider webhook signature secret for POST /api/webhooks/{provider}
# (HMAC-SHA256, checked against the X-Signature / X-Hub-Signature-256 header).
# Provider key is upper-cased, e.g. provider "fleet_gps_demo" -> WEBHOOK_SECRET_FLEET_GPS_DEMO.
# If unset for a given provider, that provider's webhook is accepted but
# recorded with signature_valid=NULL (visible in integration_webhook_events).
# WEBHOOK_SECRET_<PROVIDER>=

# John Deere Operations Center — SANDBOX ONLY (Phase 1).
# Use the existing Forest AI application ID/secret; never regenerate the secret.
JOHN_DEERE_CLIENT_ID=
JOHN_DEERE_CLIENT_SECRET=
JOHN_DEERE_REDIRECT_URI=http://localhost:9090/callback
JOHN_DEERE_ENV=sandbox
# Also requires INTEGRATION_CREDENTIALS_KEY above; retain the same key across restarts.
# The API process reads environment variables, not .env automatically.

# John Deere Phase 2B — manual sync only; no scheduler is started.
# Limits apply across manual sync actions. Deere Retry-After can extend the delay.
# JOHN_DEERE_SYNC_MIN_INTERVAL_SECONDS=60
# JOHN_DEERE_SYNC_MAX_REQUESTS=100
# Informational telemetry health (not incident triggers): <6h LIVE, 6h STALE, 24h OFFLINE.
# Deere call-in intervals vary. Tune these to the customer's actual reporting policy.
# JOHN_DEERE_TELEMETRY_STALE_SECONDS=21600
# JOHN_DEERE_TELEMETRY_OFFLINE_SECONDS=86400

# Optional immutable VMD spatial catalogue; territories remain beside each instance DB.
# VMD_DATASET_PATH=/root/forest_ai/data/vmd/compartments.sqlite
